PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=news_aggregator
DB_PORT=5432

# Redis Configuration (Optional L1 Cache & Distributed Rate Limiting; leave REDIS_HOST empty to disable)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting (Requests Per Minute per client, default: 60)
RATE_LIMIT_RPM=60

# AI Cloud Providers (Model 'auto' dynamically selects latest supported model)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=auto

NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_MODEL=auto

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=auto

# Optional AI Configuration
AI_TIMEOUT_SECONDS=25
ALLOW_INTERNAL_URLS=false

# Optional System API Keys (leave empty to auto-generate cryptographically secure random keys at startup)
# CRAWLER_SYSTEM_KEY=
# TELEGRAM_BOT_SYSTEM_KEY=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_ENABLED=false

# Autonomous News Harvester / Crawler
CRAWLER_ENABLED=true
CRAWLER_INTERVAL_MINUTES=15
CRAWLER_MAX_PER_FEED=3

# Automated Daily Briefing & Push Notification Scheduler
BRIEFING_ENABLED=true
BRIEFING_HOURS=07:00,17:00
BRIEFING_INTERVAL_MINUTES=0
BRIEFING_MAX_ARTICLES=5
