{
    "swagger": "2.0",
    "info": {
        "description": "High-performance Concurrent AI News Aggregator backend in Go with web scraping, parallel LLM summarization, and strict guardrail News Q\u0026A.",
        "title": "Concurrent AI News Aggregator API",
        "termsOfService": "https://github.com/Lesmana24/Concurrent-AI-News-Aggregator",
        "contact": {
            "name": "API Support",
            "url": "https://github.com/Lesmana24/Concurrent-AI-News-Aggregator"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/health": {
            "get": {
                "description": "Returns the operational status of the service, database connectivity, and timestamp.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health and system readiness check",
                "responses": {
                    "200": {
                        "description": "Service is healthy and operational",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "Database connectivity failure",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/news/compare": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Analyzes 2 to 5 news articles on the same topic from different outlets, reporting sentiment, framing bias, consensus facts, and discrepancies.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "News"
                ],
                "summary": "Compare multiple news articles for media bias and framing analysis",
                "parameters": [
                    {
                        "description": "List of 2 to 5 news URLs to compare",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.NewsCompareRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Comparative journalism report with bias and sentiment scores",
                        "schema": {
                            "$ref": "#/definitions/models.NewsCompareResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or insufficient URLs",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "API Key missing or invalid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "Quota exceeded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/news/qa": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Answers user questions strictly based on the extracted content of the provided news articles with anti-hallucination guardrails.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "News"
                ],
                "summary": "Ask questions about provided news articles",
                "parameters": [
                    {
                        "description": "Question and list of news URLs (max 5)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.NewsQARequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Answer generated by AI",
                        "schema": {
                            "$ref": "#/definitions/models.NewsQAResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or validation error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "API Key missing or invalid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "Quota exceeded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/news/search": {
            "get": {
                "description": "Searches stored news articles based on dense embedding cosine similarity (pgvector HNSW index).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "News"
                ],
                "summary": "Semantic vector search across archived news articles",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Search query string",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Maximum number of results to return (default 5, max 20)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Matching articles ordered by relevance",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.SemanticSearchResult"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid query parameter",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal search error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/qa": {
            "post": {
                "security": [
                    {
