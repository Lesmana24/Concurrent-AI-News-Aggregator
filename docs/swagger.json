                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "Quota exceeded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/qa/global": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Performs Retrieval-Augmented Generation (RAG) across all previously scraped news in PostgreSQL vector database.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "News"
                ],
                "summary": "Ask questions across all archived news articles (Global RAG)",
                "parameters": [
                    {
                        "description": "User question",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.GlobalQARequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Answer generated from relevant archived articles",
                        "schema": {
                            "$ref": "#/definitions/models.GlobalQAResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or validation error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "API Key missing or invalid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "Quota exceeded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/qa/stream": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Streams answer tokens incrementally in real-time (Server-Sent Events) based on extracted news content.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "News"
                ],
                "summary": "Ask questions about news articles with real-time SSE streaming",
                "parameters": [
                    {
                        "description": "Question and list of news URLs (max 5)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.NewsQARequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Server-Sent Events stream",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or validation error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "API Key missing or invalid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "Quota exceeded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/summarize": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Scrapes provided news URLs in parallel using goroutines, extracts content \u0026 real titles, queries configured AI provider with fallback, and caches results.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "News"
                ],
                "summary": "Summarize news articles concurrently",
                "parameters": [
                    {
                        "description": "List of news URLs to summarize",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SummarizeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of summarized articles",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.ArticleResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request or validation error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "API Key missing or invalid",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "403": {
                        "description": "Quota exceeded",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal processing error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.ArticleResponse": {
            "type": "object",
            "properties": {
                "source": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "models.GlobalQARequest": {
            "type": "object",
            "required": [
                "question"
            ],
            "properties": {
                "question": {
                    "type": "string",
                    "maxLength": 500,
                    "minLength": 3
                }
            }
        },
        "models.GlobalQAResponse": {
            "type": "object",
            "properties": {
                "answer": {
                    "type": "string"
                },
                "provider": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.SemanticSearchResult"
                    }
                }
            }
        },
        "models.MediaFraming": {
            "type": "object",
            "properties": {
                "dominant_framing": {
                    "description": "Sudut pandang atau penekanan utama",
                    "type": "string"
                },
                "highlighted_facts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "outlet_name": {
                    "type": "string"
                },
                "sentiment": {
                    "description": "Positif / Netral / Kritis",
                    "type": "string"
                },
                "sentiment_score": {
                    "description": "-1.0 to 1.0",
                    "type": "number"
                },
                "source_url": {
                    "type": "string"
                }
            }
        },
        "models.NewsCompareRequest": {
            "type": "object",
            "required": [
                "urls"
            ],
            "properties": {
                "urls": {
                    "type": "array",
                    "maxItems": 5,
                    "minItems": 2,
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "models.NewsCompareResponse": {
            "type": "object",
            "properties": {
                "consensus_facts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "divergences": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "media_comparisons": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.MediaFraming"
                    }
                },
                "objective_summary": {
                    "type": "string"
                },
                "provider": {
                    "type": "string"
                },
                "topic": {
                    "type": "string"
                }
            }
        },
        "models.NewsQARequest": {
            "type": "object",
            "required": [
                "question",
                "urls"
            ],
            "properties": {
                "question": {
                    "type": "string",
                    "maxLength": 500,
                    "minLength": 3
                },
                "urls": {
                    "type": "array",
                    "maxItems": 5,
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "models.NewsQAResponse": {
            "type": "object",
            "properties": {
                "answer": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                },
                "source": {
                    "type": "string"
                },
                "sources": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "models.SemanticSearchResult": {
            "type": "object",
            "properties": {
                "article_id": {
                    "type": "integer"
                },
                "similarity": {
                    "type": "number"
                },
                "source": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "models.SummarizeRequest": {
            "type": "object",
            "required": [
                "urls"
            ],
            "properties": {
                "urls": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "Personal API key for authentication and quota management",
            "type": "apiKey",
            "name": "X-API-KEY",
            "in": "header"
        }
    }
}