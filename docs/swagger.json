                        "description": "List of 2 to 5 news URLs to compare",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.NewsCompareRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Comparative journalism report with bias and sentiment scores",
                        "schema": {
                            "$ref": "#/definitions/models.NewsCompareResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body or insufficient URLs",
