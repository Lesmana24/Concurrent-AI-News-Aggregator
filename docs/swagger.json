                    }
                ],
                "description": "Answers user questions strictly based on the extracted content of the provided news articles with anti-hallucination guardrails.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "News"
                ],
                "summary": "Ask questions about provided news articles",
                "parameters": [
                    {
                        "description": "Question and list of news URLs (max 5)",
                        "name": "request",
